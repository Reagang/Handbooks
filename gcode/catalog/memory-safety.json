    "title": "Detach event handlers to prevent memory leaks",
    "domain": "memory-safety",
    "category": "memory-management",
    "severity": "critical",
    "type": "deterministic",
    "problem": "Undetached event handlers can keep objects alive and create memory leaks.",
    "why": [
      "Prevents garbage collection",
      "Creates hidden object retention",
      "Can increase memory pressure over time"
    ],
    "detection": {
      "roslyn": true,
      "aiReview": true,
      "heuristic": false
    },
    "indicators": [
      "Event subscriptions without unsubscription",
      "Long-lived publishers with short-lived subscribers"
    ],
    "fix": [
      "Unsubscribe event handlers",
      "Use weak event patterns where appropriate",
      "Dispose subscriptions correctly"
    ],
    "aiReviewPrompt": [
      "Review event subscription lifetimes.",
      "Ensure handlers are detached appropriately."
    ],
    "examples": {
      "bad": "publisher.Event += Handler;",
      "good": "publisher.Event -= Handler during disposal"
    },
    "tags": [
      "memory",
      "events",
      "gc",
      "lifecycle"
    ],
    "owner": "platform-engineering",
    "status": "analyzer",
    "analyzerId": "MEM1001"
