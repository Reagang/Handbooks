    "title": "Avoid inefficient LINQ",
    "domain": "clean-code",
    "category": "performance",
    "severity": "error",
    "type": "deterministic",
    "problem": "Inefficient LINQ usage can create unnecessary allocations and reduce application performance.",
    "why": [
      "Can allocate unnecessary collections",
      "Can cause multiple enumerations",
      "May execute expensive queries repeatedly",
      "Can degrade hot-path performance"
    ],
    "detection": {
      "roslyn": true,
      "aiReview": true,
      "heuristic": false
    },
    "indicators": [
      "Multiple ToList() calls",
      "Repeated enumeration of IEnumerable",
      "Nested LINQ queries in loops",
      "Unnecessary Select followed by ToList"
    ],
    "fix": [
      "Cache enumerations where appropriate",
      "Use dictionaries/lookups for repeated access",
      "Avoid unnecessary materialization",
      "Refactor nested LINQ in loops"
    ],
    "aiReviewPrompt": [
      "Review LINQ usage for repeated enumeration.",
      "Check for unnecessary allocations.",
      "Review hot paths for LINQ performance issues."
    ],
    "examples": {
      "bad": "orders.Where(x => x.Active).ToList().FirstOrDefault();",
      "good": "orders.FirstOrDefault(x => x.Active);"
    },
    "tags": [
      "linq",
      "performance",
      "allocations",
      "maintainability"
    ],
    "owner": "platform-engineering",
    "status": "analyzer",
    "analyzerId": "CC1001"
