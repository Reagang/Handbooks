    "domain": "clean-code",
    "category": "async",
    "severity": "error",
    "type": "deterministic",
    "problem": "Blocking async code can deadlock threads and reduce application scalability.",
    "why": [
      "Blocks thread pool threads",
      "Can cause deadlocks",
      "Reduces throughput under load"
    ],
    "detection": {
      "roslyn": true,
      "aiReview": true,
      "heuristic": false
    },
    "indicators": [
      ".Result usage",
      ".Wait() usage",
      "Thread.Sleep inside async flow"
    ],
    "fix": [
      "Use async/await end-to-end",
      "Propagate async upward",
      "Use Task.Delay instead of Thread.Sleep"
    ],
    "aiReviewPrompt": [
      "Review for sync-over-async violations.",
      "Ensure async flows remain non-blocking."
    ],
    "examples": {
      "bad": "var result = client.GetAsync(url).Result;",
      "good": "var result = await client.GetAsync(url);"
    },
    "tags": [
      "async",
